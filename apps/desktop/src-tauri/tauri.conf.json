{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetCost",
  "version": "0.1.0",
  "identifier": "app.meetcost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @meetcost/web",
    "beforeBuildCommand": "npm run build -w @meetcost/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeetCost",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
