{
  "name": "meetburner",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "test": "npm test -w @meetburner/core",
    "gen:themes": "node tools/gen-themes.mts",
    "dev:web": "npm run dev -w @meetburner/web",
    "build:web": "npm run build -w @meetburner/web",
    "deploy:web": "npm run build:web && npx --yes wrangler@4 pages deploy apps/web/dist --project-name meetburner --branch main",
    "dev:desktop": "npm run tauri -w @meetburner/desktop -- dev",
    "build:desktop": "npm run tauri -w @meetburner/desktop -- build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
