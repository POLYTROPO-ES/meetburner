{
  "name": "meetcost",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "test": "npm test -w @meetcost/core",
    "dev:web": "npm run dev -w @meetcost/web",
    "build:web": "npm run build -w @meetcost/web",
    "deploy:web": "npm run build:web && npx wrangler@4 pages deploy apps/web/dist --project-name meetcost",
    "dev:desktop": "npm run tauri -w @meetcost/desktop -- dev",
    "build:desktop": "npm run tauri -w @meetcost/desktop -- build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
